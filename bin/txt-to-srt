#!/usr/bin/env php
<?php

declare(strict_types=1);

use NoviqLabs\TxtToSrt\Application\ConvertTxtToSrt;
use NoviqLabs\TxtToSrt\Exception\ConversionException;

require dirname(__DIR__) . '/vendor/autoload.php';

$arguments = array_slice($argv, 1);
$overwrite = false;
$positionals = [];
foreach ($arguments as $argument) {
    if ($argument === '--overwrite') {
        $overwrite = true;
    } elseif ($argument === '--help' || $argument === '-h') {
        fwrite(STDOUT, "Usage: bin/txt-to-srt INPUT.txt [OUTPUT.srt] [--overwrite]\n");
        exit(0);
    } elseif (str_starts_with($argument, '-')) {
        fwrite(STDERR, "Unknown option: {$argument}\n");
        exit(2);
    } else {
        $positionals[] = $argument;
    }
}

if (count($positionals) < 1 || count($positionals) > 2) {
    fwrite(STDERR, "Usage: bin/txt-to-srt INPUT.txt [OUTPUT.srt] [--overwrite]\n");
    exit(2);
}

try {
    $result = (new ConvertTxtToSrt())->convert($positionals[0], $positionals[1] ?? null, $overwrite);
    fwrite(STDOUT, sprintf("Converted %d captions: %s -> %s (%d bytes)\n", $result->captionCount, $result->inputFile, $result->outputFile, $result->bytesWritten));
    exit(0);
} catch (ConversionException $exception) {
    fwrite(STDERR, 'Conversion failed: ' . $exception->getMessage() . "\n");
    exit(1);
}
