#!/usr/bin/env bash

set -u

project_directory="$(cd "$(dirname "$0")/.." && pwd)"
host="${TXT_TO_SRT_UI_HOST:-127.0.0.1}"
port="${TXT_TO_SRT_UI_PORT:-8080}"

printf 'Noviq TXT-to-SRT UI: http://%s:%s\n' "$host" "$port"
exec php -S "$host:$port" -t "$project_directory/public" "$project_directory/public/index.php"
