{
    "name": "noviq-labs/txt-to-srt-converter",
    "description": "Convert timestamped lyric TXT files into Premiere-compatible SRT subtitles.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcre": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "NoviqLabs\\TxtToSrt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NoviqLabs\\TxtToSrt\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/txt-to-srt"
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress",
        "coding-style": "phpcs --standard=phpcs.xml src tests bin/txt-to-srt",
        "coding-style:fix": "phpcbf --standard=phpcs.xml src tests bin/txt-to-srt",
        "quality": [
            "@test",
            "@analyse",
            "@coding-style"
        ]
    }
}
